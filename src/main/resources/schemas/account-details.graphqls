schema {
  query: Query
}

type Query {
  
  accountBalances(id: ID!): AccountBalances
}



type AccountBalances {
id: ID!
  firstName: String
  lastName: String
  accountType: String
  company: String
  address: String
  phone: String
  website: String
  balance: Balance
}

type Balance {
  amount: Float
  currency: String
  lastUpdated: String
}

type Transaction {
  transactionId: ID!
  date: String
  amount: Float
  type: String
  description: String
}